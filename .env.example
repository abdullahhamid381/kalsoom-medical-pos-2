# ----------------------------------------------------------------
# Kalsoom Medical Complex - Appointment POS
# Copy this file to ".env" and fill in real values before running.
# ----------------------------------------------------------------

# Secret used to sign login session tokens. Change this to any long
# random string before going live (e.g. generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-this-to-a-long-random-secret-before-production

# Credentials for the FIRST super admin account. These are only used
# the very first time you run "npm run seed". After that, log in and
# you can create more users from Dashboard > Users. You can change
# this admin's password later from the app itself.
SUPER_ADMIN_NAME=Kalsoom Admin
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=Admin@12345

# Clinic info shown on the printed/PDF appointment slip and in the UI.
CLINIC_NAME=Kalsoom Medical Complex
CLINIC_ADDRESS=Main Bazar Road, Bhakkar, Punjab, Pakistan
CLINIC_PHONE=+92-300-0000000
CLINIC_EMAIL=info@kalsoommedical.com

# Postgres connection string (Neon, Railway Postgres, Supabase, or any
# standard Postgres). The app creates its own tables on first run - point
# this at an empty database and it will bootstrap itself, including the
# first super admin account below.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Where the WhatsApp Web login session is stored once you scan the QR code
# (see below). Defaults to a local .wwebjs_auth folder. On Railway, point
# this at the same mounted volume as DATABASE_PATH, e.g.
# WWEBJS_DATA_PATH=/data/.wwebjs_auth, so you don't have to re-scan the QR
# code after every redeploy.
WWEBJS_DATA_PATH=./.wwebjs_auth

# --- WhatsApp automated sending (optional, advanced) ---------------
# This app can send the appointment PDF + a message automatically over
# WhatsApp using the clinic's own WhatsApp number, via an unofficial
# library (whatsapp-web.js) that drives a real WhatsApp Web session.
# To use it:
#   1. npm install (this downloads a Chromium browser, needs internet)
#   2. Start the app, log in as super admin, open Settings > WhatsApp
#   3. Scan the QR code shown there with the clinic's WhatsApp phone
#      (WhatsApp app > Linked Devices > Link a Device)
#   4. Keep the server running - the session is saved to .wwebjs_auth
#      so you only need to scan the QR once.
# If you skip this setup, the app still works perfectly - every
# appointment has a "Share on WhatsApp" button that opens WhatsApp
# with the message pre-filled so staff can send it manually with one tap,
# and "Download PDF" to attach the slip themselves.
WHATSAPP_ENABLED=true
